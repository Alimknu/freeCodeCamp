function isPrime(n) {
    // Return false for any number 0 and below
    if (n <= 1) {
        return false;
    }

    // Return true for 1 and 2
    if (n == 2) {
        return true;
    }

    for (let i = 2; i < (n / 2) + 1; i++)
    {
        if (n % i == 0)
        {
            return false;
        }
    }

    return true;
}

module.exports = {
    isPrime,
};
